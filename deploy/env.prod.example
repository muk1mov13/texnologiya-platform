# Prod sozlamalari (edubuxdpi.uz). Serverda: cp deploy/env.prod.example backend/.env
# va <...> belgilarini to'ldiring. Bu faylga haqiqiy parol va kalitlarni yozmang (u git'da).
# Kalitlar backend/app/core/config.py dagi Settings bilan bir xil.

ENV=prod
# PostgreSQL 16 + pgvector (deploy/README.md, D2-5).
DATABASE_URL=postgresql+asyncpg://texnologiya:<DB_PAROL>@localhost:5432/texnologiya
# Kuchli tasodifiy qiymat: openssl rand -hex 32
JWT_SECRET=<openssl rand -hex 32>
# Prod'da majburiy (HTTPS bo'lmasa login yangilanmaydi). Cloudflare Tunnel'da ham shu 3 qator
# (HTTPS Cloudflare'da, nginx/edubuxdpi-tunnel.conf).
COOKIE_SECURE=true
CORS_ORIGINS=["https://edubuxdpi.uz","https://www.edubuxdpi.uz"]
# Sitemap va robots.txt dagi havolalar uchun.
PUBLIC_BASE_URL=https://edubuxdpi.uz

# Domen hali yo'q (vaqtincha ochiq IP + oddiy HTTP, nginx/ip-http.conf): yuqoridagi 3 qator
# o'rniga shular. Domen tayyor bo'lgach yuqoridagi qiymatlar qaytariladi.
# COOKIE_SECURE=false
# ALLOW_INSECURE_HTTP=true
# CORS_ORIGINS=["http://<OCHIQ_IP>"]
# PUBLIC_BASE_URL=http://<OCHIQ_IP>

# Fayllar. Himoyalangan fayllarni nginx o'zi beradi (/protected-media/, internal).
MEDIA_ROOT=/srv/texnologiya/media
MEDIA_ACCEL_REDIRECT=true
SOFFICE_PATH=/usr/bin/soffice

# AI. Kalit bo'lmasa AI o'chiq turadi, qolgan sayt ishlaydi.
# Asosiy matn — Groq (compat), Gemini kaliti bo'lsa zaxira.
AI_PROVIDER=compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=<GROQ_KALIT>
LLM_MODEL_CHAT=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_RPM=30
GEMINI_API_KEY=<GEMINI_KALIT_YOKI_BOSH>
GEMINI_MODEL_CHAT=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_RPM=10

# Embedding jarayon ichida (ONNX, ~0.6 GB RAM). Model birinchi ishga tushishda
# huggingface.co dan LOCAL_EMBED_CACHE ga yuklanadi (~280 MB).
EMBEDDING_PROVIDER=local
LOCAL_EMBED_CACHE=/srv/texnologiya/models
LOCAL_EMBED_THREADS=2
# e5 modeli uchun chegaralar (kurs materiallarida o'lchangan).
AI_MIN_SIMILARITY=0.815
AI_HINT_SIMILARITY=0.89
