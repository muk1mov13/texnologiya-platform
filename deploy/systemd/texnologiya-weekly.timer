# Har dushanba 07:00 (Toshkent vaqti). Server o'chiq bo'lsa, yoqilganda bajariladi.
# Holat: systemctl list-timers texnologiya-weekly.timer

[Unit]
Description=Texnologiya platformasi: haftalik AI hisobot jadvali

[Timer]
OnCalendar=Mon *-*-* 07:00:00 Asia/Tashkent
Persistent=true

[Install]
WantedBy=timers.target
