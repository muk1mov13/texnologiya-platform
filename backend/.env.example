ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=dev-only-secret-change-me-in-production-0000
COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_ROOT=./media
# Windows: SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
SOFFICE_PATH=soffice
# AI (3-bosqich). Kalit bo'lmasa AI o'chiq turadi, qolgan sayt ishlaydi.
# AI_PROVIDER=fake — lokal sinov uchun, internetsiz deterministik javoblar.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL_CHAT=gemini-2.5-flash
AI_MODEL_FAST=gemini-2.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-001
# Daqiqasiga provayderga umumiy so'rovlar. Limitlar akkauntga bog'liq va faqat AI Studio'da
# ko'rinadi: https://aistudio.google.com/rate-limit — qiymatni ulardan past qo'ying.
AI_RPM=10
