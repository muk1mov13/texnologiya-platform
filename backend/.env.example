ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./dev.db
JWT_SECRET=dev-only-secret-change-me-in-production-0000
COOKIE_SECURE=false
# Prod'da COOKIE_SECURE=false faqat ALLOW_INSECURE_HTTP=true bilan (domensiz, oddiy HTTP).
CORS_ORIGINS=["http://localhost:5173"]
MEDIA_ROOT=./media
# Windows: SOFFICE_PATH=C:/Program Files/LibreOffice/program/soffice.exe
SOFFICE_PATH=soffice
# AI (3-bosqich). Kalit bo'lmasa AI o'chiq turadi, qolgan sayt ishlaydi.
# AI_PROVIDER — asosiy matn provayderi: compat (OpenAI'ga mos API, LLM_*) yoki gemini.
# Ikkinchisining kaliti ham bo'lsa, u zaxira: asosiy band bo'lsa (429/5xx) matn unda yaratiladi.
# AI_PROVIDER=fake — lokal sinov uchun, internetsiz deterministik javoblar.
AI_PROVIDER=gemini
# Gemini: matn (asosiy yoki zaxira) va embedding. Kalit: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_CHAT=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Daqiqasiga provayderga umumiy so'rovlar. Limitlar akkauntga bog'liq va faqat AI Studio'da
# ko'rinadi: https://aistudio.google.com/rate-limit — qiymatni ulardan past qo'ying.
GEMINI_RPM=10
# OpenAI'ga mos API (faqat matn, embedding yo'q). LLM_BASE_URL misollari:
#   Groq:       https://api.groq.com/openai/v1   (kalit: https://console.groq.com/keys)
#   Cerebras:   https://api.cerebras.ai/v1       (model: gpt-oss-120b)
#   OpenRouter: https://openrouter.ai/api/v1     (model: ...:free)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL_CHAT=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b
LLM_RPM=30

# Embedding (tutor qidiruvi):
#   local  — jarayon ichida ONNX (multilingual-e5-base int8, ~0.6 GB RAM, alohida xizmatsiz,
#            limitsiz). Model birinchi ishga tushishda LOCAL_EMBED_CACHE ga yuklanadi (~280 MB).
#   gemini — API; bepul kalitda kuniga atigi 1000 so'rov (bitta qayta indekslashning o'zi tugatadi).
#   tei    — text-embeddings-inference konteyneri (TEI_URL); ~3 GB RAM oladi.
# Model almashtirilsa: admin -> AI -> "Qayta indekslash".
EMBEDDING_PROVIDER=local
LOCAL_EMBED_CACHE=./models
LOCAL_EMBED_THREADS=2
TEI_URL=http://localhost:8080
TEI_MODEL=intfloat/multilingual-e5-base
# Tutor manba o'xshashligi chegaralari (min — manba sifatida olinadi, hint — topshiriq savoliga
# juda yaqin = ishora rejimi). Kod default'lari (0.55 / 0.85) Gemini uchun; e5 (local/tei)
# qiymatlari siqiqroq. Kurs materiallarida o'lchangan: kurs savollari 0.82–0.85, mavzudan
# tashqari 0.78–0.81, topshiriq savolining nusxasi 0.90–0.92:
# Ochiq mavzu ichida chegara ishlatilmaydi (mavzuning eng mos bo'laklari har doim olinadi);
# u faqat fan/kutubxona va mavzusiz savollardagi qo'shimcha manbalarni saralaydi.
AI_MIN_SIMILARITY=0.815
AI_HINT_SIMILARITY=0.89

# Ochiq saytning to'liq manzili: sitemap.xml va robots.txt dagi havolalar uchun.
PUBLIC_BASE_URL=http://localhost:5173
